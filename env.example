# Add these in Vercel > Project > Settings > Environment Variables.
# For local testing with `vercel dev`, copy this file to .env.local (never commit it).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RECIPIENT_EMAILS=your.name@gmail.com

# Optional. Leave out to use Resend's test sender (onboarding@resend.dev).
# Once you verify a domain in Resend you can use your own sender:
# FROM_EMAIL=AnQor Timesheets <timesheets@yourverifieddomain.com>
